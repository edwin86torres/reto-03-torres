# Proveedor del modelo: gemini (por defecto, tiene capa gratuita) | anthropic | openai | groq
LLM_PROVIDER=gemini
# Clave del proveedor. Solo en el entorno del servidor: nunca en el repo, el front ni los logs.
LLM_API_KEY=
# Opcional: modelo y URL base (OpenAI-compatible)
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_MS=45000
# Límites de costo
MAX_ITERACIONES=25
MAX_TOKENS_SESION=200000
MAX_TOKENS_GLOBAL=3000000
# Opcional: protege el link. Si se define, abrir como https://<host>/?key=<valor>
ACCESS_KEY=
PORT=3000
